VITE_API_URL=http://localhost:5000/api
VITE_WHATSAPP_NUMBER=
VITE_GOOGLE_FORM_URL=

# Shown on the Contact page — business email, phone, and physical address
# (address also drives the Google Map embed there). Leave any of these
# blank to hide that part of the contact card rather than show placeholder
# text — see BusinessContactCard.jsx / BusinessMap.jsx.
VITE_BUSINESS_EMAIL=
VITE_BUSINESS_PHONE=
VITE_BUSINESS_ADDRESS=
# Optional — overrides VITE_BUSINESS_ADDRESS for the map search only, in
# case the mailing address and the map pin shouldn't match exactly (e.g. a
# PO box vs a visitable office). Falls back to VITE_BUSINESS_ADDRESS.
VITE_BUSINESS_MAP_QUERY=
VITE_BUSINESS_HOURS=

# Blogger site embedded on /blog — see Blog.jsx.
VITE_BLOGGER_URL=https://YOUR-BLOGGER-NAME.blogspot.com/
